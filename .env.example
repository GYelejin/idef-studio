# Example environment variables for IDEF0 Studio LLM generation
# Note: Never put real API keys into VITE_* variables (they are embedded in the client bundle).
# Enter your API key directly in the UI settings modal at runtime.
VITE_LLM_API_URL=https://assistant.korolev-ai.bmstu.ru/v1
VITE_LLM_MODEL=korolev-k5
